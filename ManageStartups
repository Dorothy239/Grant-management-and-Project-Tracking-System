import { useEffect, useState, useCallback } from 'react';
import { useNavigate } from 'react-router-dom';
import { useAuth } from '@/contexts/AuthContext';
import DashboardLayout from '@/components/DashboardLayout';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Input } from '@/components/ui/input';
import { Textarea } from '@/components/ui/textarea';
import { Label } from '@/components/ui/label';
import {
  Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle, DialogTrigger, DialogFooter,
} from '@/components/ui/dialog';
import {
  Table, TableBody, TableCell, TableHead, TableHeader, TableRow,
} from '@/components/ui/table';
import {
  Select, SelectContent, SelectItem, SelectTrigger, SelectValue,
} from '@/components/ui/select';
import {
  Building2, Plus, Pencil, Power, Search, MoreHorizontal, Download, Users, TrendingUp,
  Loader2, Copy, UserPlus, DollarSign, CheckCircle2, XCircle, Clock,
} from 'lucide-react';
import {
  DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger,
} from '@/components/ui/dropdown-menu';
import { supabase } from '@/integrations/supabase/client';
import { useToast } from '@/hooks/use-toast';
import { formatNaira } from '@/lib/currency';

interface StartupWithRelations {
  id: string; name: string; description: string | null; invite_code: string;
  grant_amount: number; is_active: boolean; created_at: string;
  startup_members?: { id: string; user_id: string; role: string; profiles?: { full_name: string | null } | null }[];
  budgets?: { id: string; total_amount: number; status: string; admin_notes: string | null }[];
}

interface SearchedUser { id: string; full_name: string | null; }

export default function ManageStartups() {
  const { user, role, loading } = useAuth();
  const navigate = useNavigate();
  const { toast } = useToast();
  const [searchQuery, setSearchQuery] = useState('');
  const [isAddDialogOpen, setIsAddDialogOpen] = useState(false);
  const [isEditDialogOpen, setIsEditDialogOpen] = useState(false);
  const [isMembersDialogOpen, setIsMembersDialogOpen] = useState(false);
  const [isBudgetDialogOpen, setIsBudgetDialogOpen] = useState(false);
  const [statusFilter, setStatusFilter] = useState('all');
  const [startups, setStartups] = useState<StartupWithRelations[]>([]);
  const [loadingData, setLoadingData] = useState(true);
  const [submitting, setSubmitting] = useState(false);
  const [editingStartup, setEditingStartup] = useState<StartupWithRelations | null>(null);
  const [selectedStartup, setSelectedStartup] = useState<StartupWithRelations | null>(null);
  const [userSearch, setUserSearch] = useState('');
  const [searchedUsers, setSearchedUsers] = useState<SearchedUser[]>([]);
  const [searchingUsers, setSearchingUsers] = useState(false);
  const [budgetAction, setBudgetAction] = useState<'approved' | 'rejected'>('approved');
  const [budgetNotes, setBudgetNotes] = useState('');

  const [formData, setFormData] = useState({ name: '', description: '', grant_amount: '' });

  useEffect(() => {
    if (!loading && !user) navigate('/auth');
    if (!loading && role !== 'admin') navigate('/dashboard');
    if (user && role === 'admin') fetchStartups();
  }, [user, role, loading]);

  const fetchStartups = async () => {
    try {
      const { data, error } = await supabase
        .from('startups')
        .select(`*, startup_members(id, user_id, role, profiles:user_id(full_name)), budgets(id, total_amount, status, admin_notes)`)
        .order('created_at', { ascending: false });
      if (error) throw error;
      setStartups(data || []);
    } catch (error) {
      console.error(error);
      toast({ title: 'Error', description: 'Failed to load teams', variant: 'destructive' });
    } finally { setLoadingData(false); }
  };

  const handleAddStartup = async (e: React.FormEvent) => {
    e.preventDefault();
    setSubmitting(true);
    try {
      const { error } = await supabase.from('startups').insert({
        name: formData.name, description: formData.description || null,
        grant_amount: parseFloat(formData.grant_amount) || 0, is_active: true,
      });
      if (error) throw error;
      toast({ title: 'Team Created', description: 'New team has been created successfully. Share the invite code with members.' });
      setIsAddDialogOpen(false);
      setFormData({ name: '', description: '', grant_amount: '' });
      fetchStartups();
    } catch (error) {
      console.error(error);
      toast({ title: 'Error', description: 'Failed to create team', variant: 'destructive' });
    } finally { setSubmitting(false); }
  };

  const handleEditStartup = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!editingStartup) return;
    setSubmitting(true);
    try {
      const { error } = await supabase.from('startups').update({
        name: formData.name, description: formData.description || null,
        grant_amount: parseFloat(formData.grant_amount) || 0,
      }).eq('id', editingStartup.id);
      if (error) throw error;
      toast({ title: 'Updated', description: 'Team updated successfully' });
      setIsEditDialogOpen(false);
      setEditingStartup(null);
      fetchStartups();
    } catch (error) {
      console.error(error);
      toast({ title: 'Error', description: 'Failed to update team', variant: 'destructive' });
    } finally { setSubmitting(false); }
  };

  const handleToggleStatus = async (startup: StartupWithRelations) => {
    try {
      const { error } = await supabase.from('startups').update({ is_active: !startup.is_active }).eq('id', startup.id);
      if (error) throw error;
      toast({ title: 'Updated', description: `Team ${startup.is_active ? 'deactivated' : 'activated'}` });
      fetchStartups();
    } catch (error) {
      console.error(error);
      toast({ title: 'Error', description: 'Failed to update status', variant: 'destructive' });
    }
  };

  const openEditDialog = (s: StartupWithRelations) => {
    setEditingStartup(s);
    setFormData({ name: s.name, description: s.description || '', grant_amount: String(s.grant_amount) });
    setIsEditDialogOpen(true);
  };

  const openMembersDialog = (s: StartupWithRelations) => {
    setSelectedStartup(s);
    setIsMembersDialogOpen(true);
    setUserSearch('');
    setSearchedUsers([]);
  };

  const openBudgetDialog = (s: StartupWithRelations) => {
    setSelectedStartup(s);
    setBudgetAction('approved');
    setBudgetNotes('');
    setIsBudgetDialogOpen(true);
  };

  // Live search as user types
  const handleUserSearchChange = useCallback(async (value: string) => {
    setUserSearch(value);
    if (value.trim().length < 2) {
      setSearchedUsers([]);
      return;
    }
    setSearchingUsers(true);
    try {
      const { data } = await supabase
        .from('profiles')
        .select('id, full_name')
        .ilike('full_name', `%${value.trim()}%`)
        .limit(10);
      setSearchedUsers(data || []);
    } catch (error) {
      console.error(error);
    } finally { setSearchingUsers(false); }
  }, []);

  const handleAddMember = async (userId: string) => {
    if (!selectedStartup) return;
    try {
      const { error } = await supabase.from('startup_members').insert({
        startup_id: selectedStartup.id, user_id: userId, role: 'member',
      });
      if (error) {
        if (error.code === '23505') {
          toast({ title: 'Already a Member', description: 'This user is already in the team.', variant: 'destructive' });
        } else throw error;
      } else {
        toast({ title: 'Added', description: 'Member added to team' });
        fetchStartups();
        const updated = startups.find(s => s.id === selectedStartup.id);
        if (updated) setSelectedStartup(updated);
      }
    } catch (error) {
      console.error(error);
      toast({ title: 'Error', description: 'Failed to add member', variant: 'destructive' });
    }
  };

  const handleRemoveMember = async (memberId: string) => {
    try {
      const { error } = await supabase.from('startup_members').delete().eq('id', memberId);
      if (error) throw error;
      toast({ title: 'Removed', description: 'Member removed from team' });
      fetchStartups();
    } catch (error) {
      console.error(error);
      toast({ title: 'Error', description: 'Failed to remove member', variant: 'destructive' });
    }
  };

  const handleBudgetAction = async () => {
    if (!selectedStartup) return;
    const budget = selectedStartup.budgets?.[0];
    if (!budget) return;
    setSubmitting(true);
    try {
      const { error } = await supabase.from('budgets').update({
        status: budgetAction, approved_by: user!.id,
        approved_at: budgetAction === 'approved' ? new Date().toISOString() : null,
        admin_notes: budgetNotes || null,
      }).eq('id', budget.id);
      if (error) throw error;
      toast({ title: budgetAction === 'approved' ? 'Budget Approved' : 'Budget Rejected', description: `Budget has been ${budgetAction}.` });
      setIsBudgetDialogOpen(false);
      fetchStartups();
    } catch (error) {
      console.error(error);
      toast({ title: 'Error', description: 'Failed to update budget', variant: 'destructive' });
    } finally { setSubmitting(false); }
  };

  const copyInviteCode = (code: string) => {
    navigator.clipboard.writeText(code);
    toast({ title: 'Copied', description: 'Invite code copied to clipboard' });
  };

  const exportToCSV = () => {
    const csvContent = [
      ['Name', 'Invite Code', 'Grant Amount', 'Status', 'Members', 'Budget Status', 'Created'],
      ...filteredStartups.map(s => [
        s.name, s.invite_code, s.grant_amount,
        s.is_active ? 'Active' : 'Inactive',
        s.startup_members?.length || 0,
        s.budgets?.[0]?.status || 'No budget',
        new Date(s.created_at).toLocaleDateString(),
      ])
    ].map(row => row.join(',')).join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = `teams-${new Date().toISOString().split('T')[0]}.csv`; a.click();
    window.URL.revokeObjectURL(url);
  };

  const filteredStartups = startups.filter(s => {
    const matchesSearch = s.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
      (s.description && s.description.toLowerCase().includes(searchQuery.toLowerCase())) ||
      s.invite_code.toLowerCase().includes(searchQuery.toLowerCase());
    const matchesStatus = statusFilter === 'all' ||
      (statusFilter === 'active' && s.is_active) ||
      (statusFilter === 'inactive' && !s.is_active);
    return matchesSearch && matchesStatus;
  });

  const activeStartups = startups.filter(s => s.is_active).length;
  const totalGrants = startups.reduce((sum, s) => sum + Number(s.grant_amount), 0);
  const totalMembers = startups.reduce((sum, s) => sum + (s.startup_members?.length || 0), 0);
  const pendingBudgets = startups.filter(s => s.budgets?.[0]?.status === 'pending').length;

  if (loadingData) {
    return (
      <DashboardLayout>
        <div className="flex items-center justify-center py-20">
          <Loader2 className="h-8 w-8 animate-spin text-primary" />
        </div>
      </DashboardLayout>
    );
  }

  return (
    <DashboardLayout>
      <div className="space-y-6 animate-fade-in">
        <div className="flex items-center justify-between">
          <div>
            <h1 className="text-3xl font-bold tracking-tight">Manage Teams</h1>
            <p className="text-muted-foreground">Create teams, manage members, and review budgets</p>
          </div>
          <div className="flex gap-2">
            <Button variant="outline" onClick={exportToCSV}><Download className="mr-2 h-4 w-4" />Export</Button>
            <Dialog open={isAddDialogOpen} onOpenChange={setIsAddDialogOpen}>
              <DialogTrigger asChild>
                <Button className="bg-accent text-accent-foreground hover:bg-accent/90"><Plus className="mr-2 h-4 w-4" />Create Team</Button>
              </DialogTrigger>
              <DialogContent>
                <DialogHeader>
                  <DialogTitle>Create New Team</DialogTitle>
                  <DialogDescription>Create a team and share the generated invite code with members</DialogDescription>
                </DialogHeader>
                <form onSubmit={handleAddStartup}>
                  <div className="space-y-4 py-4">
                    <div className="space-y-2"><Label>Team Name</Label><Input placeholder="Enter team name" value={formData.name} onChange={(e) => setFormData(p => ({ ...p, name: e.target.value }))} required /></div>
                    <div className="space-y-2"><Label>Description</Label><Textarea placeholder="Brief description" value={formData.description} onChange={(e) => setFormData(p => ({ ...p, description: e.target.value }))} /></div>
                    <div className="space-y-2"><Label>{`Grant Amount (\u20A6)`}</Label><Input type="number" step="0.01" placeholder="50000.00" value={formData.grant_amount} onChange={(e) => setFormData(p => ({ ...p, grant_amount: e.target.value }))} required /></div>
                  </div>
                  <DialogFooter>
                    <Button type="button" variant="outline" onClick={() => setIsAddDialogOpen(false)}>Cancel</Button>
                    <Button type="submit" disabled={submitting}>{submitting && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}Create Team</Button>
                  </DialogFooter>
                </form>
              </DialogContent>
            </Dialog>
          </div>
        </div>

        {/* Stats */}
        <div className="grid gap-4 md:grid-cols-4">
          <Card className="border-l-4 border-l-primary">
            <CardContent className="pt-6">
              <div className="flex items-center gap-3">
                <div className="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center"><Building2 className="h-6 w-6 text-primary" /></div>
                <div><p className="text-sm text-muted-foreground">Active Teams</p><p className="text-2xl font-bold">{activeStartups}</p></div>
              </div>
            </CardContent>
          </Card>
          <Card className="border-l-4 border-l-accent">
            <CardContent className="pt-6">
              <div className="flex items-center gap-3">
                <div className="h-12 w-12 rounded-full bg-accent/10 flex items-center justify-center"><DollarSign className="h-6 w-6 text-accent" /></div>
                <div><p className="text-sm text-muted-foreground">Total Grants</p><p className="text-2xl font-bold">{formatNaira(totalGrants)}</p></div>
              </div>
            </CardContent>
          </Card>
          <Card className="border-l-4 border-l-info">
            <CardContent className="pt-6">
              <div className="flex items-center gap-3">
                <div className="h-12 w-12 rounded-full bg-info/10 flex items-center justify-center"><Users className="h-6 w-6 text-info" /></div>
                <div><p className="text-sm text-muted-foreground">Total Members</p><p className="text-2xl font-bold">{totalMembers}</p></div>
              </div>
            </CardContent>
          </Card>
          <Card className="border-l-4 border-l-warning">
            <CardContent className="pt-6">
              <div className="flex items-center gap-3">
                <div className="h-12 w-12 rounded-full bg-warning/10 flex items-center justify-center"><Clock className="h-6 w-6 text-warning" /></div>
                <div><p className="text-sm text-muted-foreground">Pending Budgets</p><p className="text-2xl font-bold">{pendingBudgets}</p></div>
              </div>
            </CardContent>
          </Card>
        </div>

        {/* Filters */}
        <Card>
          <CardContent className="pt-6">
            <div className="flex flex-col sm:flex-row gap-4">
              <div className="relative flex-1">
                <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
                <Input placeholder="Search teams or invite codes..." className="pl-9" value={searchQuery} onChange={(e) => setSearchQuery(e.target.value)} />
              </div>
              <Select value={statusFilter} onValueChange={setStatusFilter}>
                <SelectTrigger className="w-full sm:w-40"><SelectValue placeholder="Status" /></SelectTrigger>
                <SelectContent>
                  <SelectItem value="all">All Status</SelectItem>
                  <SelectItem value="active">Active</SelectItem>
                  <SelectItem value="inactive">Inactive</SelectItem>
                </SelectContent>
              </Select>
            </div>
          </CardContent>
        </Card>

        {/* Table — removed Budget column */}
        <Card>
          <CardHeader>
            <CardTitle>All Teams</CardTitle>
            <CardDescription>{filteredStartups.length} team{filteredStartups.length !== 1 ? 's' : ''}</CardDescription>
          </CardHeader>
          <CardContent>
            <Table>
              <TableHeader>
                <TableRow>
                  <TableHead>Team</TableHead>
                  <TableHead>Invite Code</TableHead>
                  <TableHead>Grant</TableHead>
                  <TableHead>Members</TableHead>
                  <TableHead>Status</TableHead>
                  <TableHead className="w-10"></TableHead>
                </TableRow>
              </TableHeader>
              <TableBody>
                {filteredStartups.length === 0 ? (
                  <TableRow><TableCell colSpan={6} className="text-center py-8 text-muted-foreground">No teams found</TableCell></TableRow>
                ) : filteredStartups.map((s) => (
                  <TableRow key={s.id}>
                    <TableCell>
                      <div className="flex items-center gap-3">
                        <div className="h-10 w-10 rounded-lg bg-primary/10 flex items-center justify-center"><Building2 className="h-5 w-5 text-primary" /></div>
                        <div>
                          <p className="font-medium">{s.name}</p>
                          <p className="text-sm text-muted-foreground truncate max-w-xs">{s.description || 'No description'}</p>
                        </div>
                      </div>
                    </TableCell>
                    <TableCell>
                      <div className="flex items-center gap-1">
                        <code className="text-sm font-mono bg-muted px-2 py-1 rounded">{s.invite_code}</code>
                        <Button variant="ghost" size="icon" className="h-7 w-7" onClick={() => copyInviteCode(s.invite_code)}><Copy className="h-3 w-3" /></Button>
                      </div>
                    </TableCell>
                    <TableCell className="font-semibold">{formatNaira(Number(s.grant_amount))}</TableCell>
                    <TableCell>{s.startup_members?.length || 0}</TableCell>
                    <TableCell>
                      <Badge variant={s.is_active ? 'default' : 'outline'}>{s.is_active ? 'Active' : 'Inactive'}</Badge>
                    </TableCell>
                    <TableCell>
                      <DropdownMenu>
                        <DropdownMenuTrigger asChild><Button variant="ghost" size="icon"><MoreHorizontal className="h-4 w-4" /></Button></DropdownMenuTrigger>
                        <DropdownMenuContent align="end">
                          <DropdownMenuItem onClick={() => navigate(`/admin/teams/${s.id}`)}><TrendingUp className="mr-2 h-4 w-4" />View Details</DropdownMenuItem>
                          <DropdownMenuItem onClick={() => openEditDialog(s)}><Pencil className="mr-2 h-4 w-4" />Edit</DropdownMenuItem>
                          <DropdownMenuItem onClick={() => openMembersDialog(s)}><UserPlus className="mr-2 h-4 w-4" />Manage Members</DropdownMenuItem>
                          {s.budgets?.[0]?.status === 'pending' && (
                            <DropdownMenuItem onClick={() => openBudgetDialog(s)}><DollarSign className="mr-2 h-4 w-4" />Review Budget</DropdownMenuItem>
                          )}
                          <DropdownMenuItem onClick={() => handleToggleStatus(s)}><Power className="mr-2 h-4 w-4" />{s.is_active ? 'Deactivate' : 'Activate'}</DropdownMenuItem>
                        </DropdownMenuContent>
                      </DropdownMenu>
                    </TableCell>
                  </TableRow>
                ))}
              </TableBody>
            </Table>
          </CardContent>
        </Card>

        {/* Edit Dialog */}
        <Dialog open={isEditDialogOpen} onOpenChange={setIsEditDialogOpen}>
          <DialogContent>
            <DialogHeader><DialogTitle>Edit Team</DialogTitle></DialogHeader>
            <form onSubmit={handleEditStartup}>
              <div className="space-y-4 py-4">
                <div className="space-y-2"><Label>Team Name</Label><Input value={formData.name} onChange={(e) => setFormData(p => ({ ...p, name: e.target.value }))} required /></div>
                <div className="space-y-2"><Label>Description</Label><Textarea value={formData.description} onChange={(e) => setFormData(p => ({ ...p, description: e.target.value }))} /></div>
                <div className="space-y-2"><Label>{`Grant Amount (\u20A6)`}</Label><Input type="number" step="0.01" value={formData.grant_amount} onChange={(e) => setFormData(p => ({ ...p, grant_amount: e.target.value }))} required /></div>
              </div>
              <DialogFooter>
                <Button type="button" variant="outline" onClick={() => setIsEditDialogOpen(false)}>Cancel</Button>
                <Button type="submit" disabled={submitting}>{submitting && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}Save</Button>
              </DialogFooter>
            </form>
          </DialogContent>
        </Dialog>

        {/* Members Dialog — live search */}
        <Dialog open={isMembersDialogOpen} onOpenChange={setIsMembersDialogOpen}>
          <DialogContent className="sm:max-w-lg">
            <DialogHeader>
              <DialogTitle>Manage Members - {selectedStartup?.name}</DialogTitle>
              <DialogDescription>Add or remove team members. Invite code: <code className="font-mono bg-muted px-1">{selectedStartup?.invite_code}</code></DialogDescription>
            </DialogHeader>
            <div className="space-y-4 py-4">
              <div className="relative">
                <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
                <Input
                  placeholder="Start typing a name to search..."
                  className="pl-9"
                  value={userSearch}
                  onChange={(e) => handleUserSearchChange(e.target.value)}
                />
                {searchingUsers && <Loader2 className="absolute right-3 top-1/2 -translate-y-1/2 h-4 w-4 animate-spin text-muted-foreground" />}
              </div>
              {searchedUsers.length > 0 && (
                <div className="border rounded-md divide-y max-h-40 overflow-auto">
                  {searchedUsers.map(u => {
                    const isMember = selectedStartup?.startup_members?.some(m => m.user_id === u.id);
                    return (
                      <div key={u.id} className="flex items-center justify-between p-2 text-sm">
                        <span>{u.full_name || 'Unknown'}</span>
                        {isMember ? <Badge variant="outline" className="text-xs">Already member</Badge> : (
                          <Button size="sm" variant="outline" onClick={() => handleAddMember(u.id)}><UserPlus className="mr-1 h-3 w-3" />Add</Button>
                        )}
                      </div>
                    );
                  })}
                </div>
              )}
              {userSearch.trim().length >= 2 && searchedUsers.length === 0 && !searchingUsers && (
                <p className="text-sm text-muted-foreground text-center py-2">No users found matching "{userSearch}"</p>
              )}
              <div>
                <p className="text-sm font-medium mb-2">Current Members ({selectedStartup?.startup_members?.length || 0})</p>
                <div className="border rounded-md divide-y max-h-48 overflow-auto">
                  {selectedStartup?.startup_members?.map(m => (
                    <div key={m.id} className="flex items-center justify-between p-2 text-sm">
                      <div className="flex items-center gap-2">
                        <span>{m.profiles?.full_name || 'Unknown'}</span>
                        <Badge variant="secondary" className="text-xs capitalize">{m.role}</Badge>
                      </div>
                      <Button size="sm" variant="ghost" className="text-destructive h-7" onClick={() => handleRemoveMember(m.id)}>Remove</Button>
                    </div>
                  ))}
                  {(!selectedStartup?.startup_members || selectedStartup.startup_members.length === 0) && (
                    <p className="p-3 text-sm text-muted-foreground text-center">No members yet</p>
                  )}
                </div>
              </div>
            </div>
          </DialogContent>
        </Dialog>

        {/* Budget Review Dialog */}
        <Dialog open={isBudgetDialogOpen} onOpenChange={setIsBudgetDialogOpen}>
          <DialogContent>
            <DialogHeader>
              <DialogTitle>Review Budget - {selectedStartup?.name}</DialogTitle>
              <DialogDescription>
                Requested: {formatNaira(Number(selectedStartup?.budgets?.[0]?.total_amount || 0))} | Grant: {formatNaira(Number(selectedStartup?.grant_amount || 0))}
              </DialogDescription>
            </DialogHeader>
            <div className="space-y-4 py-4">
              <div className="space-y-2">
                <Label>Decision</Label>
                <Select value={budgetAction} onValueChange={(v) => setBudgetAction(v as 'approved' | 'rejected')}>
                  <SelectTrigger><SelectValue /></SelectTrigger>
                  <SelectContent>
                    <SelectItem value="approved">Approve</SelectItem>
                    <SelectItem value="rejected">Reject</SelectItem>
                  </SelectContent>
                </Select>
              </div>
              <div className="space-y-2">
                <Label>Notes (optional)</Label>
                <Textarea placeholder="Feedback for the team..." value={budgetNotes} onChange={(e) => setBudgetNotes(e.target.value)} />
              </div>
            </div>
            <DialogFooter>
              <Button variant="outline" onClick={() => setIsBudgetDialogOpen(false)}>Cancel</Button>
              <Button onClick={handleBudgetAction} disabled={submitting} variant={budgetAction === 'approved' ? 'default' : 'destructive'}>
                {submitting && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}
                {budgetAction === 'approved' ? 'Approve Budget' : 'Reject Budget'}
              </Button>
            </DialogFooter>
          </DialogContent>
        </Dialog>
      </div>
    </DashboardLayout>
  );
}
