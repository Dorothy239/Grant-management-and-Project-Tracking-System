import { useEffect, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useAuth } from '@/contexts/AuthContext';
import { useStartup } from '@/hooks/useStartup';
import DashboardLayout from '@/components/DashboardLayout';
import { supabase } from '@/integrations/supabase/client';
import { useToast } from '@/hooks/use-toast';
import { useActivityLog } from '@/hooks/useActivityLog';
import { useCustomPhases } from '@/hooks/useCustomPhases';
import { formatNaira } from '@/lib/currency';
import { Loader2 } from 'lucide-react';

export default function StudentDashboard() {
  const { user, role, loading } = useAuth();
  const { startup, budget, loading: startupLoading, refetch } = useStartup();
  const { logActivity } = useActivityLog();
  useCustomPhases(startup?.id);

  const navigate = useNavigate();
  const { toast } = useToast();

  const [inviteCode, setInviteCode] = useState('');
  const [joining, setJoining] = useState(false);
  const [budgetSubmitting, setBudgetSubmitting] = useState(false);

  const [taskStats, setTaskStats] = useState({ total: 0, completed: 0, inProgress: 0 });
  const [totalSpent, setTotalSpent] = useState(0);
  const [docCount, setDocCount] = useState(0);

  const [expendituresByCategory, setExpendituresByCategory] = useState<
    { name: string; value: number }[]
  >([]);

  const [burnRateData, setBurnRateData] = useState<
    { day: string; spent: number; projected: number }[]
  >([]);

  const [phaseAllocations, setPhaseAllocations] = useState<Record<string, string>>({});
  const [budgetPhaseList, setBudgetPhaseList] = useState<string[]>([]);

  // Redirect logic
  useEffect(() => {
    if (loading) return;

    if (!user) {
      navigate('/auth');
      return;
    }

    if (role === 'admin') {
      navigate('/admin');
    }
  }, [user, role, loading, navigate]);

  // Fetch stats safely
  useEffect(() => {
    if (!startup) return;

    let isMounted = true;

    const load = async () => {
      await fetchStats(isMounted);
    };

    load();

    return () => {
      isMounted = false;
    };
  }, [startup]);

  const fetchStats = async (isMounted = true) => {
    if (!startup) return;

    try {
      const [tasksRes, expRes, docsRes] = await Promise.all([
        supabase.from('tasks').select('status').eq('startup_id', startup.id),
        supabase
          .from('expenditures')
          .select('amount, category, date, created_at')
          .eq('startup_id', startup.id)
          .order('date', { ascending: true }),
        supabase.from('documents').select('id').eq('startup_id', startup.id),
      ]);

      if (tasksRes.error || expRes.error || docsRes.error) {
        throw new Error('Failed to fetch stats');
      }

      if (!isMounted) return;

      const tasks = tasksRes.data ?? [];
      const exps = expRes.data ?? [];

      setTaskStats({
        total: tasks.length,
        completed: tasks.filter(t => t.status === 'completed').length,
        inProgress: tasks.filter(t => t.status === 'in_progress').length,
      });

      const spent = exps.reduce((s, e) => s + Number(e.amount ?? 0), 0);
      setTotalSpent(spent);
      setDocCount(docsRes.data?.length ?? 0);

      const catMap: Record<string, number> = {};
      exps.forEach(e => {
        if (!e.category) return;
        catMap[e.category] = (catMap[e.category] || 0) + Number(e.amount ?? 0);
      });

      setExpendituresByCategory(
        Object.entries(catMap).map(([name, value]) => ({ name, value }))
      );

      if (exps.length > 0 && startup.created_at) {
        const startDate = new Date(startup.created_at);
        if (isNaN(startDate.getTime())) return;

        const endDate = new Date(startDate);
        endDate.setMonth(endDate.getMonth() + 6);

        const totalDays = Math.max(
          1,
          Math.ceil((endDate.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24))
        );

        const grantAmt = Number(startup.grant_amount ?? 0);

        const dailyMap: Record<string, number> = {};
        exps.forEach(e => {
          const d = e.date || e.created_at?.split('T')[0];
          if (!d) return;
          dailyMap[d] = (dailyMap[d] || 0) + Number(e.amount ?? 0);
        });

        const sortedDates = Object.keys(dailyMap).sort();
        let cumulative = 0;

        const dataPoints: { day: string; spent: number; projected: number }[] = [];

        sortedDates.forEach(d => {
          cumulative += dailyMap[d];

          const dayNum = Math.max(
            1,
            Math.ceil((new Date(d).getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24))
          );

          const projected = (grantAmt / totalDays) * dayNum;

          dataPoints.push({
            day: d,
            spent: cumulative,
            projected: Math.round(projected),
          });
        });

        setBurnRateData(dataPoints);
      }
    } catch (err) {
      console.error(err);
      toast({
        title: 'Error',
        description: 'Failed to load dashboard data',
        variant: 'destructive',
      });
    }
  };

  // Join team (safer)
  const handleJoinTeam = async () => {
    if (!user || !inviteCode.trim() || joining) return;

    setJoining(true);
    try {
      const { data, error } = await supabase
        .from('startups')
        .select('id, name')
        .eq('invite_code', inviteCode.trim().toUpperCase())
        .maybeSingle();

      if (error) throw error;

      if (!data) {
        toast({
          title: 'Invalid Code',
          description: 'No team found.',
          variant: 'destructive',
        });
        return;
      }

      const { error: joinError } = await supabase.from('startup_members').insert({
        startup_id: data.id,
        user_id: user.id,
        role: 'member',
      });

      if (joinError?.code === '23505') {
        toast({
          title: 'Already a Member',
          description: 'You are already in this team.',
          variant: 'destructive',
        });
      } else if (joinError) {
        throw joinError;
      } else {
        toast({ title: 'Welcome!', description: `Joined ${data.name}` });
        await refetch();
      }
    } catch (err) {
      console.error(err);
      toast({
        title: 'Error',
        description: 'Failed to join team.',
        variant: 'destructive',
      });
    } finally {
      setJoining(false);
    }
  };

  // Submit budget (safer numbers)
  const handleSubmitBudget = async () => {
    if (!user || !startup) return;

    setBudgetSubmitting(true);
    try {
      const allocations: Record<string, number> = {};
      let total = 0;

      for (const phase of budgetPhaseList) {
        const val = Number(phaseAllocations[phase]) || 0;
        if (val > 0) {
          allocations[phase] = val;
          total += val;
        }
      }

      if (total <= 0) {
        toast({
          title: 'Invalid Budget',
          description: 'Add at least one allocation.',
          variant: 'destructive',
        });
        return;
      }

      const grant = Number(startup.grant_amount ?? 0);
      const status = total > grant ? 'rejected' : 'pending';

      const { error } = await supabase.from('budgets').insert({
        startup_id: startup.id,
        total_amount: total,
        status,
        phase_allocations: allocations,
        submitted_by: user.id,
      });

      if (error) throw error;

      await logActivity(startup.id, `submitted budget (${formatNaira(total)})`);

      toast({
        title: status === 'rejected' ? 'Budget Rejected' : 'Budget Submitted',
        description: formatNaira(total),
      });

      await refetch();
      fetchStats();
    } catch (err) {
      console.error(err);
      toast({
        title: 'Error',
        description: 'Failed to submit budget.',
        variant: 'destructive',
      });
    } finally {
      setBudgetSubmitting(false);
    }
  };

  // Loading state
  if (loading || startupLoading) {
    return (
      <DashboardLayout>
        <div className="flex items-center justify-center py-20">
          <Loader2 className="h-8 w-8 animate-spin text-primary" />
        </div>
      </DashboardLayout>
    );
  }

  return (
    <DashboardLayout>
      <div className="p-6">
        {/* Your UI stays the same */}
        <h1 className="text-2xl font-bold">Student Dashboard</h1>
      </div>
    </DashboardLayout>
  );
}
